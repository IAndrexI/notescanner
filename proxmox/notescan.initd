#!/sbin/openrc-run

name="notescan"
description="NoteScan (Document Scanner for Seafile)"
command="/usr/bin/node"
command_args="/opt/notescan/server.js"
command_user="root"
directory="/opt/notescan"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/notescan.log"
error_log="/var/log/notescan.err"

depend() {
    need net
    after firewall
}

start_pre() {
    export PORT="${PORT:-3000}"
    export NODE_ENV=production
    export DATA_DIR="${DATA_DIR:-/opt/notescan/data}"
    mkdir -p /opt/notescan/data
}
